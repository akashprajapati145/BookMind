# Supabase — create a project at https://supabase.com
# Settings → API → Project URL and anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Storage — create a bucket named "bookmind" (private) in Storage dashboard

# Google Gemini API keys (rotate across keys if one hits quota)
GOOGLE_API_KEY=
GOOGLE_API_KEY_FALLBACK=
GOOGLE_API_KEY_FALLBACK_2=
GOOGLE_API_KEY_FALLBACK_3=
